NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://trytendr.org

# Supabase service role key — bypasses RLS; used only in server-side admin/cron routes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared with SMS backend — copy from that Railway service
OPENAI_API_KEY=sk-...

# Anthropic (Claude) — used by the nightly AI quality review job
ANTHROPIC_API_KEY=sk-ant-...

# Twilio — add both to the portal Railway service
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# Admin dashboard — set a strong random password
ADMIN_PASSWORD=your-strong-admin-password

# Admin alerts — email address to receive critical failure notifications
ADMIN_EMAIL=admin@your-domain.com

# SendGrid — used to send admin alert emails
SENDGRID_API_KEY=SG....

# Cron job secret — used to authenticate the nightly quality review HTTP call
# Configure Railway scheduler: POST /api/cron/quality-review with header x-cron-secret: <value>
# Schedule: 0 2 * * *  (daily at 2am UTC)
CRON_SECRET=your-cron-secret

# E2E testing — separate test Supabase project
# Apply supabase/migrations/ to the test project before running tests
SUPABASE_TEST_URL=https://your-test-project.supabase.co
SUPABASE_TEST_ANON_KEY=your-test-anon-key
SUPABASE_TEST_SERVICE_ROLE_KEY=your-test-service-role-key
E2E_TEST_EMAIL=e2e-runner@your-domain.com
E2E_TEST_PASSWORD=your-e2e-password
# Second tenant user — required for multi-tenant isolation tests (isolation.spec.ts)
E2E_TEST_EMAIL_B=e2e-tenant-b@your-domain.com
E2E_TEST_PASSWORD_B=your-e2e-b-password
